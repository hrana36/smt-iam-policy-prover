{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicAnonymousS3Access",
      "Effect": "Allow",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::corporate-confidential-bucket/*",
        "arn:aws:s3:::corporate-confidential-bucket"
      ]
    }
  ]
}
