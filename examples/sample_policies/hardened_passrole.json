{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDeveloperCodeDeployScoped",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:dev-*"
    },
    {
      "Sid": "RestrictedPassRoleOnlyDevRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::123456789012:role/service-roles/dev-*",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
